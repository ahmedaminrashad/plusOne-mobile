default_platform(:ios)

APP_IDENTIFIER = "com.refaat.plusone"
EXTENSION_IDENTIFIER = "com.refaat.plusone.ShareExtension"
XCODEPROJ = "ios/PlusOne.xcodeproj"
WORKSPACE = "ios/PlusOne.xcworkspace"
SCHEME = "PlusOne"

platform :ios do
  desc "Build and upload PlusOne to TestFlight"
  lane :beta do
    ensure_env_vars(
      env_vars: [
        "APPLE_TEAM_ID",
        "APP_STORE_CONNECT_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID",
        "APP_STORE_CONNECT_API_KEY"
      ]
    )

    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    update_project_team(
      path: XCODEPROJ,
      teamid: ENV["APPLE_TEAM_ID"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest + 1
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "login.keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    # Reuse the distribution cert already installed on this CI keychain.
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    # force: true so profiles pick up latest App ID capabilities (App Groups).
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    main_profile_name = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: EXTENSION_IDENTIFIER,
      force: true
    )
    extension_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOne"],
      code_sign_identity: "Apple Distribution",
      profile_name: main_profile_name,
      build_configurations: ["Release"]
    )
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOneShareExtension"],
      code_sign_identity: "Apple Distribution",
      profile_name: extension_profile_name,
      build_configurations: ["Release"]
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => main_profile_name,
          EXTENSION_IDENTIFIER => extension_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end
end
