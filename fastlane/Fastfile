default_platform(:ios)

require "base64"
require "shellwords"

APP_IDENTIFIER = "com.refaat.plusone"
EXTENSION_IDENTIFIER = "com.refaat.plusone.ShareExtension"
XCODEPROJ = "ios/PlusOne.xcodeproj"
WORKSPACE = "ios/PlusOne.xcworkspace"
SCHEME = "PlusOne"
P12_PATH = File.expand_path(ENV["GITHUB_WORKSPACE"] ? File.join(ENV["GITHUB_WORKSPACE"], "ci_distribution.p12") : "ci_distribution.p12")
P12_PASSWORD = "plusone-ci"

platform :ios do
  desc "Build and upload PlusOne to TestFlight"
  lane :beta do
    ensure_env_vars(
      env_vars: [
        "APPLE_TEAM_ID",
        "APP_STORE_CONNECT_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID",
        "APP_STORE_CONNECT_API_KEY"
      ]
    )

    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    update_project_team(
      path: XCODEPROJ,
      teamid: ENV["APPLE_TEAM_ID"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest + 1
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "login.keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    install_distribution_certificate(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    ensure_push_notifications_capability
    delete_app_store_profiles!(app_identifier: APP_IDENTIFIER)

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    main_profile_name = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: EXTENSION_IDENTIFIER,
      force: true
    )
    extension_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOne"],
      code_sign_identity: "Apple Distribution",
      profile_name: main_profile_name,
      build_configurations: ["Release"]
    )
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOneShareExtension"],
      code_sign_identity: "Apple Distribution",
      profile_name: extension_profile_name,
      build_configurations: ["Release"]
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      destination: "generic/platform=iOS",
      skip_profile_detection: true,
      xcodebuild_formatter: "",
      buildlog_path: "fastlane/logs",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          APP_IDENTIFIER => main_profile_name,
          EXTENSION_IDENTIFIER => extension_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  error do |_lane, _exception|
    logs = Dir[File.join(__dir__, "logs", "*.log")]
    log = logs.max_by { |f| File.mtime(f) }
    next unless log && File.file?(log)

    UI.important("---- last 80 lines of #{log} ----")
    File.readlines(log).last(80).each { |line| UI.command_output(line) }
  end

  desc "Invite an external TestFlight tester by email (TESTFLIGHT_TESTER_EMAIL)"
  lane :invite_tester do |options|
    ensure_env_vars(
      env_vars: [
        "APP_STORE_CONNECT_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID",
        "APP_STORE_CONNECT_API_KEY"
      ]
    )

    email = (options[:email] || ENV["TESTFLIGHT_TESTER_EMAIL"]).to_s.strip
    UI.user_error!("Pass email: or set TESTFLIGHT_TESTER_EMAIL") if email.empty?

    first_name = (options[:first_name] || ENV["TESTFLIGHT_TESTER_FIRST_NAME"] || email.split("@").first || "Tester").to_s
    last_name = (options[:last_name] || ENV["TESTFLIGHT_TESTER_LAST_NAME"] || "User").to_s
    group_name = (options[:group] || ENV["TESTFLIGHT_GROUP"] || "External Testers").to_s

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App #{APP_IDENTIFIER} not found in App Store Connect") unless app

    group = app.get_beta_groups(filter: { name: group_name }).first
    unless group
      UI.message("Creating beta group '#{group_name}'")
      group = app.create_beta_group(
        group_name: group_name,
        is_internal_group: false
      )
    end
    UI.user_error!("Could not find or create beta group '#{group_name}'") unless group&.id

    existing = Spaceship::ConnectAPI.get_beta_testers(filter: { email: email }).first
    if existing
      UI.message("Adding existing tester #{email} to '#{group_name}'")
      Spaceship::ConnectAPI.add_beta_tester_to_group(
        beta_group_id: group.id,
        beta_tester_ids: [existing.id]
      )
    else
      UI.message("Inviting #{email} to '#{group_name}'")
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [group.id],
        attributes: {
          email: email,
          firstName: first_name,
          lastName: last_name
        }
      )
    end
    UI.success("Invited #{email} to TestFlight group '#{group_name}'")
  end

  private_lane :ensure_push_notifications_capability do
    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])
    )
    Spaceship::ConnectAPI.token = token

    bundle = Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)
    UI.user_error!(
      "Bundle ID #{APP_IDENTIFIER} not found in App Store Connect."
    ) unless bundle

    caps = bundle.get_capabilities || []
    types = caps.map do |cap|
      cap.respond_to?(:capability_type) ? cap.capability_type.to_s : cap.to_s
    end
    UI.message("Bundle capabilities: #{types.join(', ')}")

    unless types.include?("PUSH_NOTIFICATIONS")
      UI.message("Adding PUSH_NOTIFICATIONS on #{APP_IDENTIFIER} via App Store Connect API")
      begin
        bundle.create_capability(
          Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
        )
      rescue => e
        UI.user_error!(
          "Push is checked in the Developer portal but the App Store profile still has no aps-environment. " \
          "Delete the App Store provisioning profile for #{APP_IDENTIFIER} in " \
          "https://developer.apple.com/account/resources/profiles/list then re-run. " \
          "API error: #{e.message}"
        )
      end
    end
  end

  # sigh --force often reuses a profile created before Push was on the bundle.
  # Delete App Store profiles for this id so the next sigh run is a clean create.
  private_lane :delete_app_store_profiles! do |options|
    identifier = options[:app_identifier]
    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])
    )
    Spaceship::ConnectAPI.token = token

    profiles = Spaceship::ConnectAPI::Profile.all || []
    profiles.each do |profile|
      type = profile.respond_to?(:profile_type) ? profile.profile_type.to_s : ""
      name = profile.respond_to?(:name) ? profile.name.to_s : ""
      next unless type.include?("APP_STORE")
      next unless name.include?(identifier)

      UI.important("Deleting stale App Store profile '#{name}'")
      begin
        profile.delete!
      rescue => e
        UI.important("Could not delete #{name}: #{e.message}")
      end
    end
  end

  private_lane :install_distribution_certificate do |options|
    api_key = options[:api_key]
    keychain_path = options[:keychain_path]
    keychain_password = options[:keychain_password]

    if ENV["IOS_DISTRIBUTION_P12_BASE64"].to_s.strip.empty?
      UI.message("No IOS_DISTRIBUTION_P12_BASE64 secret — revoking old certs and creating a new one")
      revoke_ios_distribution_certificates
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
      export_distribution_p12(
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    else
      UI.message("Importing distribution certificate from IOS_DISTRIBUTION_P12_BASE64")
      File.binwrite(P12_PATH, Base64.decode64(ENV["IOS_DISTRIBUTION_P12_BASE64"]))
      import_certificate(
        certificate_path: P12_PATH,
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_P12_PASSWORD", P12_PASSWORD),
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end
  end

  private_lane :revoke_ios_distribution_certificates do
    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])
    )
    Spaceship::ConnectAPI.token = token

    types = %w[DISTRIBUTION IOS_DISTRIBUTION]
    Spaceship::ConnectAPI::Certificate.all.each do |cert|
      next unless types.include?(cert.certificate_type)

      UI.important("Revoking distribution certificate #{cert.id} (#{cert.certificate_type})")
      Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
    end
  end

  private_lane :export_distribution_p12 do |options|
    keychain_path = options[:keychain_path]
    password = P12_PASSWORD

    sh(
      [
        "security", "export",
        "-k", keychain_path,
        "-t", "identities",
        "-f", "pkcs12",
        "-P", password,
        "-o", P12_PATH
      ].shelljoin
    )
    UI.success("Exported #{P12_PATH} (password: #{P12_PASSWORD}). Upload artifact and store as GitHub secrets for future runs.")
  end
end
