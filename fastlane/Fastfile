default_platform(:ios)

require "base64"
require "shellwords"

APP_IDENTIFIER = "com.refaat.plusone"
EXTENSION_IDENTIFIER = "com.refaat.plusone.ShareExtension"
XCODEPROJ = "ios/PlusOne.xcodeproj"
WORKSPACE = "ios/PlusOne.xcworkspace"
SCHEME = "PlusOne"
P12_PATH = File.expand_path("ci_distribution.p12")
P12_PASSWORD = "plusone-ci"

platform :ios do
  desc "Build and upload PlusOne to TestFlight"
  lane :beta do
    ensure_env_vars(
      env_vars: [
        "APPLE_TEAM_ID",
        "APP_STORE_CONNECT_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID",
        "APP_STORE_CONNECT_API_KEY"
      ]
    )

    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    update_project_team(
      path: XCODEPROJ,
      teamid: ENV["APPLE_TEAM_ID"]
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest + 1
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "login.keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")

    install_distribution_certificate(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: keychain_password
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )
    main_profile_name = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: EXTENSION_IDENTIFIER,
      force: true
    )
    extension_profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOne"],
      code_sign_identity: "Apple Distribution",
      profile_name: main_profile_name,
      build_configurations: ["Release"]
    )
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["PlusOneShareExtension"],
      code_sign_identity: "Apple Distribution",
      profile_name: extension_profile_name,
      build_configurations: ["Release"]
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => main_profile_name,
          EXTENSION_IDENTIFIER => extension_profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  private_lane :install_distribution_certificate do |options|
    api_key = options[:api_key]
    keychain_path = options[:keychain_path]
    keychain_password = options[:keychain_password]

    if ENV["IOS_DISTRIBUTION_P12_BASE64"].to_s.strip.empty?
      UI.message("No IOS_DISTRIBUTION_P12_BASE64 secret — revoking old certs and creating a new one")
      revoke_ios_distribution_certificates
      get_certificates(
        api_key: api_key,
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
      export_distribution_p12(
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    else
      UI.message("Importing distribution certificate from IOS_DISTRIBUTION_P12_BASE64")
      File.binwrite(P12_PATH, Base64.decode64(ENV["IOS_DISTRIBUTION_P12_BASE64"]))
      import_certificate(
        certificate_path: P12_PATH,
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_P12_PASSWORD", P12_PASSWORD),
        keychain_path: keychain_path,
        keychain_password: keychain_password
      )
    end
  end

  private_lane :revoke_ios_distribution_certificates do
    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key: Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY"])
    )
    Spaceship::ConnectAPI.token = token

    types = %w[DISTRIBUTION IOS_DISTRIBUTION]
    Spaceship::ConnectAPI::Certificate.all.each do |cert|
      next unless types.include?(cert.certificate_type)

      UI.important("Revoking distribution certificate #{cert.id} (#{cert.certificate_type})")
      Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
    end
  end

  private_lane :export_distribution_p12 do |options|
    keychain_path = options[:keychain_path]
    password = P12_PASSWORD

    sh(
      [
        "security", "export",
        "-k", keychain_path,
        "-t", "identities",
        "-f", "pkcs12",
        "-P", password,
        "-o", P12_PATH
      ].shelljoin
    )
    UI.success("Exported #{P12_PATH} (password: #{P12_PASSWORD}). Upload artifact and store as GitHub secrets for future runs.")
  end
end
